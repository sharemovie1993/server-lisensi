# --- STATIC CENTRAL ROUTES ---

# Central Landing/Portal Page
absenta.id, www.absenta.id {
    root * /var/www/absenta.id
    file_server
    try_files {path} {path}/ /index.html
}

# Central License Server API & admin UI
api.absenta.id {
    reverse_proxy 127.0.0.1:5001
}

# Central SaaS App Onboarding & Portal Gateway (Registrasi & RAB Calculator via WireGuard Tunnel)
app.absenta.id {
    tls /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/wildcard_.absenta.id/wildcard_.absenta.id.crt /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/wildcard_.absenta.id/wildcard_.absenta.id.key
    reverse_proxy 10.0.0.25:5174
}

# Central POS System
pos.absenta.id {
    reverse_proxy 10.0.0.3:3002
}





